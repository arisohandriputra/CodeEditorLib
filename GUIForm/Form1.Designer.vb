    ' ─── Layout ───────────────────────────────────────────────
    Private Sub Form1_Resize(ByVal sender As Object, ByVal e As EventArgs)
        LayoutPanels()
        RepositionTabs()
    End Sub

    Private Sub LayoutPanels()
        Dim w = Me.ClientSize.Width
        Dim y As Integer = MenuStrip1.Bottom

        ToolBarPanel.SetBounds(0, y, w, 36)
        y += 36

        ' Reserve 24px on right for scroll buttons
        Dim btnW As Integer = 24
        btnScrollLeft.SetBounds(0, y, btnW, 32)
        TabsPanel.SetBounds(btnW, y, w - btnW * 2, 32)
        btnScrollRight.SetBounds(w - btnW, y, btnW, 32)
        y += 32

        Dim findH = If(FindPanel.Visible, 70, 0)
        FindPanel.SetBounds(0, y, w, 70)
        If FindPanel.Visible Then y += 60

        btnCloseFindPanel.Location = New System.Drawing.Point(w - 30, 4)

        Dim statusH = StatusStrip1.Height
        Dim editorH = Math.Max(50, Me.ClientSize.Height - y - statusH)
        EditorHostPanel.SetBounds(0, y, w, editorH)

        StatusStrip1.SetBounds(0, Me.ClientSize.Height - statusH, w, statusH)
    End Sub

