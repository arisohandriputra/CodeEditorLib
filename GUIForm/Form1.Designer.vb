    ' ─── Custom dark renderer for MenuStrip ───────────────────
    Private Class DarkMenuRenderer
        Inherits System.Windows.Forms.ToolStripProfessionalRenderer

        Private Shared ReadOnly _darkFg As System.Drawing.Color = System.Drawing.Color.FromArgb(220, 220, 220)
        Private Shared ReadOnly _darkBg As System.Drawing.Color = System.Drawing.Color.FromArgb(45, 45, 48)
        Private Shared ReadOnly _highlightBg As System.Drawing.Color = System.Drawing.Color.FromArgb(0, 122, 204)

        Public Sub New()
            MyBase.New(New DarkColorTable())
        End Sub

        Protected Overrides Sub OnRenderMenuItemBackground(ByVal e As System.Windows.Forms.ToolStripItemRenderEventArgs)
            Dim bgColor = If(e.Item.Selected OrElse e.Item.Pressed, _highlightBg, _darkBg)
            Using br = New System.Drawing.SolidBrush(bgColor)
                e.Graphics.FillRectangle(br, New System.Drawing.Rectangle(System.Drawing.Point.Empty, e.Item.Size))
            End Using
        End Sub

        Protected Overrides Sub OnRenderItemText(ByVal e As System.Windows.Forms.ToolStripItemTextRenderEventArgs)
            ' Paksa warna teks terang di semua item menu (termasuk dropdown)
            e.TextColor = If(e.Item.Enabled, _darkFg, System.Drawing.Color.FromArgb(120, 120, 120))
            MyBase.OnRenderItemText(e)
        End Sub

        Protected Overrides Sub OnRenderToolStripBackground(ByVal e As System.Windows.Forms.ToolStripRenderEventArgs)
            Using br = New System.Drawing.SolidBrush(_darkBg)
                e.Graphics.FillRectangle(br, e.AffectedBounds)
            End Using
        End Sub

        Protected Overrides Sub OnRenderSeparator(ByVal e As System.Windows.Forms.ToolStripSeparatorRenderEventArgs)
            Dim y = e.Item.Height \ 2
            Using pen = New System.Drawing.Pen(System.Drawing.Color.FromArgb(70, 70, 75))
                e.Graphics.DrawLine(pen, 30, y, e.Item.Width - 4, y)
            End Using
        End Sub
    End Class

    Private Class DarkColorTable
        Inherits System.Windows.Forms.ProfessionalColorTable

        Public Overrides ReadOnly Property MenuItemSelected As System.Drawing.Color
            Get
                Return System.Drawing.Color.FromArgb(0, 122, 204)
            End Get
        End Property

        Public Overrides ReadOnly Property MenuBorder As System.Drawing.Color
            Get
                Return System.Drawing.Color.FromArgb(60, 60, 65)
            End Get
        End Property

        Public Overrides ReadOnly Property ToolStripDropDownBackground As System.Drawing.Color
            Get
